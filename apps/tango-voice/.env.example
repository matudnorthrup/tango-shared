# Voice operator environment. See docs/guides/voice-operator.md.
# Pass this file (and/or the bot's .env) with --env-file.

# --- Required ---

# Discord bot token. The operator joins voice as this bot.
DISCORD_TOKEN=

# Discord server (guild) ID. Optional when the operator profile sets it.
DISCORD_GUILD_ID=

# Must match the bot's voice bridge key.
TANGO_VOICE_BRIDGE_API_KEY=

# --- Optional ---

# Needed only for `auth: api` (an OpenAI key with gpt-live-1 access).
# `auth: codex` uses the Codex CLI login instead.
# OPENAI_API_KEY=

# Bot voice bridge location, if you changed the bot's defaults.
# TANGO_VOICE_BRIDGE_PORT=8787
# TANGO_VOICE_BRIDGE_PATH=/voice/turn

# Operator config file. Defaults to <profile config dir>/voice-operator.yaml.
# TANGO_VOICE_OPERATOR_CONFIG=

# Agent the operator treats as chief of staff (default: watson).
# TANGO_OPERATOR_CHIEF=watson

# Bot work-status endpoint.
# TANGO_BOT_STATUS_URL=http://127.0.0.1:9200/status/work

# Token for Agent Desk local-only posts, when the desk requires one.
# TANGO_COLLABORATION_BRIDGE_TOKEN=
