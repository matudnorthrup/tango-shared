# Discord
DISCORD_TOKEN=
# Per-agent Discord bot tokens for typing indicators (optional)
# JULES_DISCORD_TOKEN= (WELLNESS_DISCORD_TOKEN honored as fallback)
# PIPER_DISCORD_TOKEN=
# CODE_DISCORD_TOKEN=
# Wellness note-librarian bounded file tool root (optional)
# JULES_WELLNESS_FILES_ROOT=~/.tango/profiles/default/wellness (WELLNESS_FILES_ROOT honored as fallback)
DISCORD_TEST_GUILD_ID=
DISCORD_COMMAND_GUILD_ID=
DISCORD_TEST_CHANNEL_ID=
DISCORD_ENABLE_MESSAGE_CONTENT=false

# Runtime
NODE_ENV=development
LOG_LEVEL=info
DISCORD_LISTEN_ONLY=true

# Access control defaults (used when agent config does not set `access`)
TANGO_ACCESS_MODE=allowlist
TANGO_ALLOWLIST_CHANNEL_IDS=
TANGO_ALLOWLIST_USER_IDS=

# Provider (Phase 1)
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=medium
TANGO_PROVIDER_TIMEOUT_MS=300000
# Optional per-provider overrides:
# CLAUDE_TIMEOUT_MS=300000
# CLAUDE_SECONDARY_CLI_COMMAND=/path/to/claude-secondary
# CLAUDE_SECONDARY_MODEL=
# CLAUDE_SECONDARY_EFFORT=medium
# CLAUDE_SECONDARY_TIMEOUT_MS=300000
CLAUDE_HARNESS_COMMAND=claude
CLAUDE_HARNESS_MODEL=
# CLAUDE_HARNESS_EFFORT=medium
# CLAUDE_HARNESS_TIMEOUT_MS=300000
CODEX_CLI_COMMAND=codex
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=medium
# CODEX_TIMEOUT_MS=300000
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=never
TANGO_PROVIDER_RETRY_LIMIT=1
TANGO_WORKER_DISPATCH_TIMEOUT_MS=900000
TANGO_CAPTURE_PROVIDER_RAW=false
TANGO_MEMORY_COMPACTION_TRIGGER_TURNS=24
TANGO_MEMORY_COMPACTION_RETAIN_RECENT_TURNS=8
TANGO_MEMORY_COMPACTION_SUMMARY_MAX_CHARS=1800

# Sage: merge a small Atlas (pinned + memory_search) block into tango-memory warm-start.
# Set to 0 to disable. TANGO_SAGE_ATLAS_WARMSTART_MAX_CHARS caps appendix size (UTF-8).
# TANGO_SAGE_ATLAS_WARMSTART_BRIDGE=0
# TANGO_SAGE_ATLAS_WARMSTART_MAX_CHARS=4000

# Sage V2 reloadable worker. When enabled, Discord gateway stays up while
# `npm run bot:reload:worker` swaps the Sage turn-execution worker after build.
TANGO_SAGE_V2_WORKER_ENABLED=false
TANGO_SAGE_V2_WORKER_DRAIN_TIMEOUT_MS=120000

TANGO_VOICE_BRIDGE_ENABLED=false
TANGO_VOICE_BRIDGE_HOST=127.0.0.1
TANGO_VOICE_BRIDGE_PORT=8787
TANGO_VOICE_BRIDGE_PATH=/voice/turn
TANGO_MOBILE_VOICE_DISPATCH_PATH=/mobile/voice-dispatch
TANGO_VOICE_BRIDGE_API_KEY=
TANGO_VOICE_DEFAULT_SESSION_ID=voice-main
TANGO_VOICE_DEFAULT_AGENT_ID=watson

# Optional runtime path overrides
# TANGO_HOME=~/.tango
# TANGO_PROFILE=default
# TANGO_BROWSER_PROFILE_DIR=
# ^ The automation browser's cookie jar. Defaults to ~/.tango/browser-profile
#   for every run — one browser on one CDP port means one jar. Set this only to
#   deliberately create a second jar; a per-worktree value re-creates the split
#   where logins saved by one run are missing in another.
# TANGO_PRINTER_STATUS_URL=http://<printer-ip>/api/v1/status
# TANGO_PRINTER_API_KEY=
# ^ 3D printer monitor (PrusaLink REST API). Both are required; with either
#   missing the printer-monitor job reports "not configured" and does nothing.
#   Prefer the printer's IP over its .local name: mDNS resolution from Node is
#   unreliable and the 5 s fetch timeout eats it. The key is on the printer
#   under Settings > Network > PrusaLink (not the Prusa Connect token).

# 1Password service account
OP_SERVICE_ACCOUNT_TOKEN=

# Per-site 1Password logins for authenticated browser sessions. Each
# browser-site descriptor names its own pair of env vars (credential.vault_env /
# credential.item_env), so the variables you need depend on which descriptors you
# have in <profile>/config/browser-sites/. See docs/guides/browser-sessions.md.
# <SITE>_1PASSWORD_VAULT=
# <SITE>_1PASSWORD_ITEM=

# Optional config/storage overrides
# TANGO_CONFIG_DIR=
# TANGO_DB_PATH=
# Explicit output root for enabled state-views (may be an Obsidian vault).
# TANGO_STATE_PROJECTION_ROOT=/absolute/path/to/generated-state-views
